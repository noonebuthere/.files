{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "custom/sep",
        "pulseaudio",
        "network",
        "custom/sep",
        "disk",
        "memory",
        "cpu",
        "temperature",
        "custom/sep",
        "idle_inhibitor",
	"custom/sep",
        "battery"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "hyprland/submap": {
        "format": "  {}"
    },

    "custom/sep": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "clock": {
        "format": "{:%Y-%m-%d  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "{:%A, %B %d %Y}"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "󱃃 {temperatureC}°",
        "format-critical": "󰸁 {temperatureC}°",
        "tooltip": false
    },

    "disk": {
        "path": "/",
        "format": "󰋊 {percentage_used}%",
        "tooltip-format": "{used} / {total} used on {path}"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛐",
            "deactivated": "󰾪"
        },
        "tooltip": false
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰂄  {capacity}%",
        "format-icons": ["󰂎","󰁺","󰁼","󰁾","󰂀","󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "network": {
        "interval": 2,
        "format-wifi": "󰖩  {signalStrength}%",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) @ {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname} — {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟  muted",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    }
}
